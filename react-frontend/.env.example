# Copy to .env.local and adjust. Vite reads these at build time.

# Flask backend (app.py). Set to an empty value to build a demo-only site
# (no sign-in or upload; only the bundled demo project is shown).
VITE_API_BASE=http://localhost:5000

# GeoServer WMS endpoint for the "Sharanga" workspace (ortho / height / health layers).
VITE_GEOSERVER_WMS=http://localhost:8080/geoserver/Sharanga/wms
